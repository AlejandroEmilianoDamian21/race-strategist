# HTTP port the API listens on
PORT=3000
# Allowed browser origin (the frontend dev server)
CORS_ORIGIN=http://localhost:5173
# Upstream F1 data API
F1_API_BASE_URL=https://tech-challenge101.onrender.com
# Upstream request timeout in ms (the free-tier host can take ~60s to wake up)
F1_API_TIMEOUT_MS=75000
# Retries after a failed upstream request
F1_API_RETRIES=1
# In-memory cache TTL for upstream responses in ms (1 hour)
F1_API_CACHE_TTL_MS=3600000
